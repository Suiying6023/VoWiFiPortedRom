@@ -1,4 +1,4 @@
-
+//SPDX-License-Identifier: GPL-2.0
 package me.phh.ims;
 
 import android.telephony.ims.feature.MmTelFeature;
@@ -52,8 +52,74 @@
 		});
 		Rlog.d(TAG, "Final capabilities: " + this.capabilities);
 
-		MmTelFeature.MmTelCapabilities capabilities = new MmTelFeature.MmTelCapabilities();
-		capabilities.addCapabilities(this.capabilities);
-		notifyCapabilitiesStatusChanged(capabilities);
+		notifyCapabilities();
+	}
+
+	// Re-announce the negotiated capabilities. Kotlin cannot build
+	// MmTelFeature.MmTelCapabilities and reach notifyCapabilitiesStatusChanged, so the
+	// call lives here and PhhMmTelFeature invokes it once SIP registration succeeds.
+	public void notifyCapabilities() {
+		ensureHiddenApiExempt();
+		// HyperOS (SDK 37) replaced ImsFeature#notifyCapabilitiesStatusChanged(MmTelCapabilities)
+		// with notifyCapabilitiesStatusChanged(ImsFeature.Capabilities) + IImsCapabilityCallback.
+		// Our compile-time android.jar only has the old signature, so the call resolved to
+		// nothing at runtime and the framework never saw VOICE/SMS. Use reflection to hit
+		// whichever signature this device actually has.
+		boolean reported = false;
+		try {
+			Class<?> capsClass = Class.forName("android.telephony.ims.feature.ImsFeature$Capabilities");
+			// Capabilities(int) is protected; use the public no-arg ctor + addCapabilities(int).
+			Object caps = capsClass.getConstructor().newInstance();
+			capsClass.getMethod("addCapabilities", int.class).invoke(caps, this.capabilities);
+			java.lang.reflect.Method m =
+				ImsFeature.class.getDeclaredMethod("notifyCapabilitiesStatusChanged", capsClass);
+			m.setAccessible(true);
+			m.invoke(this, caps);
+			Rlog.d(TAG, "notifyCapabilities (HyperOS API) " + this.capabilities);
+			reported = true;
+		} catch (Throwable t) {
+			Rlog.w(TAG, "HyperOS notifyCapabilitiesStatusChanged failed: " + t);
+		}
+		if (!reported) {
+			try {
+				MmTelFeature.MmTelCapabilities capabilities = new MmTelFeature.MmTelCapabilities();
+				capabilities.addCapabilities(this.capabilities);
+				notifyCapabilitiesStatusChanged(capabilities);
+				Rlog.d(TAG, "notifyCapabilities (legacy API) " + this.capabilities);
+			} catch (Throwable t) {
+				Rlog.e(TAG, "notifyCapabilities failed both ways: " + t);
+			}
+		}
+	}
+
+	private static volatile boolean sHiddenApiExempt = false;
+
+	// ImsFeature$Capabilities and notifyCapabilitiesStatusChanged(Capabilities) are hidden
+	// (MAX-TARGET-O); reflection on them from a targetSdk-33 app is blocked, so getConstructor()
+	// throws NoSuchMethodException. This is the same mechanism that blocked
+	// ServerSocket.getFileDescriptor$ earlier. setHiddenApiExemptions itself is hidden too,
+	// so reach it through Class.class.getDeclaredMethod (which is public).
+	private static void ensureHiddenApiExempt() {
+		if (sHiddenApiExempt) return;
+		try {
+			java.lang.reflect.Method forName =
+				Class.class.getDeclaredMethod("forName", String.class);
+			java.lang.reflect.Method getDeclaredMethod = Class.class.getDeclaredMethod(
+				"getDeclaredMethod", String.class, Class[].class);
+			Class<?> vmClass = (Class<?>) forName.invoke(null, "dalvik.system.VMRuntime");
+			java.lang.reflect.Method getRuntime = (java.lang.reflect.Method) getDeclaredMethod.invoke(
+				vmClass, "getRuntime", (Object[]) null);
+			java.lang.reflect.Method setExemptions = (java.lang.reflect.Method) getDeclaredMethod.invoke(
+				vmClass, "setHiddenApiExemptions", new Class[]{String[].class});
+			setExemptions.setAccessible(true);
+			Object runtime = getRuntime.invoke(null);
+			setExemptions.invoke(runtime, (Object) new String[]{"L"});
+			Rlog.d(TAG, "hidden api exemption set");
+			sHiddenApiExempt = true;
+		} catch (Throwable t) {
+			Throwable c = t.getCause();
+			Rlog.w(TAG, "hidden api exemption failed: " + t
+				+ (c != null ? " cause=" + c : ""));
+		}
 	}
 }
